diff --git a/drivers/video/fbdev/core/cfbcondecor.c b/drivers/video/fbdev/core/cfbcondecor.c
new file mode 100644
index 000000000000..5d6a69fb48b9
--- /dev/null
+++ b/drivers/video/fbdev/core/cfbcondecor.c
@@ -0,0 +1,409 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ *  linux/drivers/video/fbdev/core/cfbcondecor.c -- Framebuffer decor render functions
+ *
+ *  Copyright (C) 2004 Michal Januszewski <michalj+fbcondecor@gmail.com>
+ *
+ *  Code based upon "Bootdecor" (C) 2001-2003
+ *       Volker Poplawski <volker@poplawski.de>,
+ *       Stefan Reinauer <stepan@suse.de>,
+ *       Steffen Winterfeldt <snwint@suse.de>,
+ *       Michael Schroeder <mls@suse.de>,
+ *       Ken Wimer <wimer@suse.de>.
+ *
+ *  This file is subject to the terms and conditions of the GNU General Public
+ *  License.  See the file COPYING in the main directory of this archive for
+ *  more details.
+ *
+ *  The decorations are drawn directly into the screen memory (which may be a
+ *  shadow buffer in system memory with drivers using deferred I/O), so every
+ *  drawing operation reports the modified area through fb_ops.fb_damage.
+ */
+
+#include <linux/fb.h>
+#include <linux/io.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/selection.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/vt_kern.h>
+
+#include "fbcon.h"
+#include "fbcondecor.h"
+
+#define cc2cx(a)						\
+	((info->fix.visual == FB_VISUAL_TRUECOLOR ||		\
+	  info->fix.visual == FB_VISUAL_DIRECTCOLOR) ?		\
+	 ((u32 *)info->pseudo_palette)[a] : (a))
+
+static inline unsigned int bytes_per_pixel(const struct fb_info *info)
+{
+	return (info->var.bits_per_pixel + 7) >> 3;
+}
+
+static void fbcon_decor_damage(struct fb_info *info, int x, int y,
+			       int width, int height)
+{
+	if (!info->fbops->fb_damage)
+		return;
+
+	if (x < 0 || y < 0 || x >= info->var.xres || y >= info->var.yres)
+		return;
+
+	width = min_t(int, width, info->var.xres - x);
+	height = min_t(int, height, info->var.yres - y);
+	if (width <= 0 || height <= 0)
+		return;
+
+	info->fbops->fb_damage(info, x, y, width, height);
+}
+
+/*
+ * Renders a 1 bpp bitmap @src (rows padded to whole bytes) of @width x @height
+ * pixels at (@xpos, @ypos). Set bits are drawn in @fgx, clear bits in @bgx
+ * or, when @transparent is set, with the background picture.
+ */
+static void fbcon_decor_renderc(struct fb_info *info, int ypos, int xpos,
+				int height, int width, const u8 *src,
+				u32 fgx, u32 bgx, bool transparent)
+{
+	unsigned int bytespp = bytes_per_pixel(info);
+	const u8 *decor_src = info->bgdecor.data +
+		(ypos * info->var.xres + xpos) * bytespp;
+	u8 __iomem *dst = info->screen_base +
+		ypos * info->fix.line_length + xpos * bytespp;
+	unsigned int x, y;
+	u8 bits = 0;
+	u32 dd;
+
+	if (ypos < 0 || xpos < 0 ||
+	    ypos + height > info->var.yres || xpos + width > info->var.xres)
+		return;
+
+	for (y = 0; y < height; y++) {
+		switch (info->var.bits_per_pixel) {
+		case 32:
+			for (x = 0; x < width; x++) {
+				if ((x & 7) == 0)
+					bits = *src++;
+				if (bits & 0x80)
+					dd = fgx;
+				else
+					dd = transparent ?
+					     *(const u32 *)decor_src : bgx;
+				bits <<= 1;
+				decor_src += 4;
+				fb_writel(dd, dst);
+				dst += 4;
+			}
+			break;
+		case 24:
+			for (x = 0; x < width; x++) {
+				if ((x & 7) == 0)
+					bits = *src++;
+				if (bits & 0x80)
+					dd = fgx;
+				else
+					dd = transparent ?
+					     (*(const u32 *)decor_src & 0xffffff) : bgx;
+				bits <<= 1;
+				decor_src += 3;
+#ifdef __LITTLE_ENDIAN
+				fb_writew(dd & 0xffff, dst);
+				fb_writeb(dd >> 16, dst + 2);
+#else
+				fb_writew(dd >> 8, dst);
+				fb_writeb(dd & 0xff, dst + 2);
+#endif
+				dst += 3;
+			}
+			break;
+		case 16:
+			for (x = 0; x < width; x++) {
+				if ((x & 7) == 0)
+					bits = *src++;
+				if (bits & 0x80)
+					dd = fgx;
+				else
+					dd = transparent ?
+					     *(const u16 *)decor_src : bgx;
+				bits <<= 1;
+				decor_src += 2;
+				fb_writew(dd, dst);
+				dst += 2;
+			}
+			break;
+		case 8:
+			for (x = 0; x < width; x++) {
+				if ((x & 7) == 0)
+					bits = *src++;
+				if (bits & 0x80)
+					dd = fgx;
+				else
+					dd = transparent ? *decor_src : bgx;
+				bits <<= 1;
+				decor_src++;
+				fb_writeb(dd, dst);
+				dst++;
+			}
+			break;
+		}
+
+		dst += info->fix.line_length - width * bytespp;
+		decor_src += (info->var.xres - width) * bytespp;
+	}
+}
+
+/* Fills a rectangle with a solid color. */
+static void decorset(u8 __iomem *dst, int height, int width, int dstbytes,
+		     u32 bgx, int bpp)
+{
+	int i;
+
+	while (height-- > 0) {
+		u8 __iomem *p = dst;
+
+		switch (bpp) {
+		case 32:
+			for (i = 0; i < width; i++) {
+				fb_writel(bgx, p);
+				p += 4;
+			}
+			break;
+		case 24:
+			for (i = 0; i < width; i++) {
+#ifdef __LITTLE_ENDIAN
+				fb_writew(bgx & 0xffff, p);
+				fb_writeb(bgx >> 16, p + 2);
+#else
+				fb_writew(bgx >> 8, p);
+				fb_writeb(bgx & 0xff, p + 2);
+#endif
+				p += 3;
+			}
+			break;
+		case 16:
+			for (i = 0; i < width; i++) {
+				fb_writew(bgx, p);
+				p += 2;
+			}
+			break;
+		case 8:
+			for (i = 0; i < width; i++) {
+				fb_writeb(bgx, p);
+				p++;
+			}
+			break;
+		}
+
+		dst += dstbytes;
+	}
+}
+
+/* Copies a rectangle of the background picture to the screen. */
+static void decorfill(struct fb_info *info, int sy, int sx, int height,
+		      int width)
+{
+	unsigned int bytespp = bytes_per_pixel(info);
+	size_t rowlen;
+	u8 __iomem *dst;
+	const u8 *src;
+
+	if (sx < 0 || sy < 0 || sx >= info->var.xres || sy >= info->var.yres)
+		return;
+
+	width = min_t(int, width, info->var.xres - sx);
+	height = min_t(int, height, info->var.yres - sy);
+	if (width <= 0 || height <= 0)
+		return;
+
+	rowlen = (size_t)width * bytespp;
+	dst = info->screen_base + sy * info->fix.line_length + sx * bytespp;
+	src = info->bgdecor.data + ((size_t)sy * info->var.xres + sx) * bytespp;
+
+	while (height-- > 0) {
+		if (info->flags & FBINFO_VIRTFB)
+			memcpy((void __force *)dst, src, rowlen);
+		else
+			memcpy_toio(dst, src, rowlen);
+		dst += info->fix.line_length;
+		src += (size_t)info->var.xres * bytespp;
+	}
+}
+
+void fbcon_decor_putcs(struct vc_data *vc, struct fb_info *info,
+		       const unsigned short *s, int count, int yy, int xx,
+		       int fg_color, int bg_color)
+{
+	unsigned short charmask = vc->vc_hi_font_mask ? 0x1ff : 0xff;
+	unsigned int charcount = vc->vc_font.charcount;
+	unsigned int cellsize = vc->vc_font.height *
+				DIV_ROUND_UP(vc->vc_font.width, 8);
+	struct fbcon_par *par = info->fbcon_par;
+	bool transparent;
+	const u8 *src;
+	u32 bgx, fgx;
+	u16 c;
+	int x0;
+
+	/* Don't paint the background image if console is blanked */
+	transparent = !par->blank_state && vc->vc_decor.bg_color == bg_color;
+
+	xx = xx * vc->vc_font.width + vc->vc_decor.tx;
+	yy = yy * vc->vc_font.height + vc->vc_decor.ty;
+	x0 = xx;
+
+	fgx = cc2cx(fg_color);
+	bgx = cc2cx(bg_color);
+
+	while (count--) {
+		c = scr_readw(s++) & charmask;
+		if (c >= charcount)
+			c = 0;
+		src = vc->vc_font.data + c * cellsize;
+
+		fbcon_decor_renderc(info, yy, xx, vc->vc_font.height,
+				    vc->vc_font.width, src, fgx, bgx,
+				    transparent);
+		xx += vc->vc_font.width;
+	}
+
+	fbcon_decor_damage(info, x0, yy, xx - x0, vc->vc_font.height);
+}
+
+void fbcon_decor_cursor(struct fb_info *info, struct fb_cursor *cursor)
+{
+	struct fbcon_par *par = info->fbcon_par;
+	const u8 *image = (const u8 *)cursor->image.data;
+	const u8 *mask = (const u8 *)cursor->mask;
+	unsigned int dsize, s_pitch, i;
+	struct vc_data *vc;
+	int x, y;
+	u8 *src;
+
+	/* we really don't need any cursors while the console is blanked */
+	if (info->state != FBINFO_STATE_RUNNING || par->blank_state ||
+	    par->currcon < 0)
+		return;
+
+	vc = vc_cons[par->currcon].d;
+	if (!vc)
+		return;
+
+	s_pitch = DIV_ROUND_UP(cursor->image.width, 8);
+	dsize = s_pitch * cursor->image.height;
+	src = kmalloc(dsize, GFP_ATOMIC);
+	if (!src)
+		return;
+
+	if (cursor->enable) {
+		switch (cursor->rop) {
+		case ROP_XOR:
+			for (i = 0; i < dsize; i++)
+				src[i] = image[i] ^ mask[i];
+			break;
+		case ROP_COPY:
+		default:
+			for (i = 0; i < dsize; i++)
+				src[i] = image[i] & mask[i];
+			break;
+		}
+	} else {
+		memcpy(src, image, dsize);
+	}
+
+	x = cursor->image.dx + vc->vc_decor.tx;
+	y = cursor->image.dy + vc->vc_decor.ty;
+
+	fbcon_decor_renderc(info, y, x, cursor->image.height,
+			    cursor->image.width, src,
+			    cc2cx(cursor->image.fg_color),
+			    cc2cx(cursor->image.bg_color),
+			    cursor->image.bg_color == vc->vc_decor.bg_color);
+	fbcon_decor_damage(info, x, y, cursor->image.width,
+			   cursor->image.height);
+
+	kfree(src);
+}
+
+void fbcon_decor_clear(struct vc_data *vc, struct fb_info *info, int sy, int sx,
+		       int height, int width, int bg_color)
+{
+	struct fbcon_par *par = info->fbcon_par;
+	bool transparent = vc->vc_decor.bg_color == bg_color;
+	u8 __iomem *dst;
+
+	sy = sy * vc->vc_font.height + vc->vc_decor.ty;
+	sx = sx * vc->vc_font.width + vc->vc_decor.tx;
+	height *= vc->vc_font.height;
+	width *= vc->vc_font.width;
+
+	if (sx < 0 || sy < 0 || sx >= info->var.xres || sy >= info->var.yres)
+		return;
+
+	width = min_t(int, width, info->var.xres - sx);
+	height = min_t(int, height, info->var.yres - sy);
+	if (width <= 0 || height <= 0)
+		return;
+
+	/* Don't paint the background image if console is blanked */
+	if (transparent && !par->blank_state) {
+		decorfill(info, sy, sx, height, width);
+	} else {
+		dst = info->screen_base + sy * info->fix.line_length +
+		      sx * bytes_per_pixel(info);
+		decorset(dst, height, width, info->fix.line_length,
+			 cc2cx(bg_color), info->var.bits_per_pixel);
+	}
+
+	fbcon_decor_damage(info, sx, sy, width, height);
+}
+
+void fbcon_decor_clear_margins(struct vc_data *vc, struct fb_info *info,
+			       int bottom_only)
+{
+	int tx = vc->vc_decor.tx;
+	int ty = vc->vc_decor.ty;
+	int tw = vc->vc_cols * vc->vc_font.width;
+	int th = vc->vc_rows * vc->vc_font.height;
+	int xres = info->var.xres;
+	int yres = info->var.yres;
+
+	if (!bottom_only) {
+		/* top margin */
+		decorfill(info, 0, 0, ty, xres);
+		/* left margin */
+		decorfill(info, ty, 0, th, tx);
+		/* right margin */
+		decorfill(info, ty, tx + tw, th, xres - tx - tw);
+		fbcon_decor_damage(info, 0, 0, xres, ty + th);
+	}
+	/* bottom margin */
+	decorfill(info, ty + th, 0, yres - ty - th, xres);
+	fbcon_decor_damage(info, 0, ty + th, xres, yres - ty - th);
+}
+
+void fbcon_decor_blank(struct vc_data *vc, struct fb_info *info, int blank)
+{
+	if (blank) {
+		decorset(info->screen_base, info->var.yres, info->var.xres,
+			 info->fix.line_length, 0, info->var.bits_per_pixel);
+		fbcon_decor_damage(info, 0, 0, info->var.xres, info->var.yres);
+	} else {
+		update_screen(vc);
+		fbcon_decor_clear_margins(vc, info, 0);
+	}
+}
+
+/*
+ * In 8 bpp modes the background picture comes with its own palette (entries
+ * above the 16 console colors); load it before the console palette.
+ */
+void fbcon_decor_set_palette(struct vc_data *vc, struct fb_info *info)
+{
+	if (fbcon_decor_active(info, vc) && info->var.bits_per_pixel == 8 &&
+	    info->bgdecor.cmap.red)
+		fb_set_cmap(&info->bgdecor.cmap, info);
+}
