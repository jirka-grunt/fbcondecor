diff --git a/drivers/video/fbdev/core/fbcondecor.c b/drivers/video/fbdev/core/fbcondecor.c
new file mode 100644
index 000000000000..d1aee559c96a
--- /dev/null
+++ b/drivers/video/fbdev/core/fbcondecor.c
@@ -0,0 +1,679 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ *  linux/drivers/video/fbdev/core/fbcondecor.c -- Framebuffer console decorations
+ *
+ *  Copyright (C) 2004-2009 Michal Januszewski <michalj+fbcondecor@gmail.com>
+ *
+ *  Code based upon "Bootsplash" (C) 2001-2003
+ *       Volker Poplawski <volker@poplawski.de>,
+ *       Stefan Reinauer <stepan@suse.de>,
+ *       Steffen Winterfeldt <snwint@suse.de>,
+ *       Michael Schroeder <mls@suse.de>,
+ *       Ken Wimer <wimer@suse.de>.
+ *
+ *  Compat ioctl support by Thorsten Klein <TK@Thorsten-Klein.de>.
+ *
+ *  This file is subject to the terms and conditions of the GNU General Public
+ *  License.  See the file COPYING in the main directory of this archive for
+ *  more details.
+ */
+
+#include <linux/compat.h>
+#include <linux/console.h>
+#include <linux/errno.h>
+#include <linux/fb.h>
+#include <linux/fs.h>
+#include <linux/kernel.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/overflow.h>
+#include <linux/printk.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/sysctl.h>
+#include <linux/types.h>
+#include <linux/uaccess.h>
+#include <linux/umh.h>
+#include <linux/vmalloc.h>
+#include <linux/vt_kern.h>
+
+#include "fbcon.h"
+#include "fbcondecor.h"
+
+#define FBCON_DECOR_PATH_LEN	256
+
+static bool fbcon_decor_registered;
+
+static char fbcon_decor_path[FBCON_DECOR_PATH_LEN] = "/sbin/fbcondecor_helper";
+
+static const struct ctl_table fbcon_decor_sysctl_table[] = {
+	{
+		.procname	= "fbcondecor",
+		.data		= fbcon_decor_path,
+		.maxlen		= sizeof(fbcon_decor_path),
+		.mode		= 0644,
+		.proc_handler	= proc_dostring,
+	},
+};
+
+/*
+ * Runs the userspace helper for console @vc_num. Called with the console
+ * lock held; the helper is only waited for until it has been executed, its
+ * ioctls then block until the lock is released again.
+ */
+int fbcon_decor_call_helper(const char *cmd, unsigned short vc_num)
+{
+	char *envp[] = {
+		"HOME=/",
+		"PATH=/sbin:/bin",
+		NULL
+	};
+	struct fb_info *info = fbcon_info_from_console(vc_num);
+	struct vc_data *vc = vc_cons[vc_num].d;
+	char tfb[8];
+	char tcons[8];
+	char *argv[] = {
+		fbcon_decor_path,
+		"2",
+		(char *)cmd,
+		tcons,
+		tfb,
+		vc ? vc->vc_decor.theme : NULL,
+		NULL
+	};
+
+	snprintf(tfb, sizeof(tfb), "%d", info ? info->node : 0);
+	snprintf(tcons, sizeof(tcons), "%d", vc_num);
+
+	return call_usermodehelper(fbcon_decor_path, argv, envp, UMH_WAIT_EXEC);
+}
+
+/* Disables decorations on a virtual console; called with the console lock held. */
+int fbcon_decor_disable(struct vc_data *vc, bool redraw)
+{
+	struct fb_info *info;
+	struct fbcon_par *par;
+	unsigned int cols, rows;
+
+	if (!vc->vc_decor.state)
+		return -EINVAL;
+
+	vc->vc_decor.state = 0;
+
+	info = fbcon_info_from_console(vc->vc_num);
+	if (!info || !info->fbcon_par)
+		return -EINVAL;
+	par = info->fbcon_par;
+
+	cols = FBCON_SWAP(par->rotate, info->var.xres, info->var.yres);
+	rows = FBCON_SWAP(par->rotate, info->var.yres, info->var.xres);
+	vc_resize(vc, cols / vc->vc_font.width, rows / vc->vc_font.height);
+
+	if (fg_console == vc->vc_num && redraw) {
+		redraw_screen(vc, 0);
+		update_region(vc, vc->vc_origin + vc->vc_size_row * vc->vc_top,
+			      vc->vc_size_row * (vc->vc_bottom - vc->vc_top) / 2);
+	}
+
+	pr_info("fbcondecor: switched decor state to 'off' on console %d\n",
+		vc->vc_num);
+
+	return 0;
+}
+
+/* Enables decorations on a virtual console; called with the console lock held. */
+static int fbcon_decor_enable(struct vc_data *vc)
+{
+	struct fb_info *info = fbcon_info_from_console(vc->vc_num);
+
+	if (!info || !info->fbcon_par ||
+	    vc->vc_decor.twidth == 0 || vc->vc_decor.theight == 0 ||
+	    vc->vc_decor.state ||
+	    (!info->bgdecor.data && vc->vc_num == fg_console))
+		return -EINVAL;
+
+	vc->vc_decor.state = 1;
+	vc_resize(vc, vc->vc_decor.twidth / vc->vc_font.width,
+		  vc->vc_decor.theight / vc->vc_font.height);
+
+	if (fg_console == vc->vc_num) {
+		redraw_screen(vc, 0);
+		update_region(vc, vc->vc_origin + vc->vc_size_row * vc->vc_top,
+			      vc->vc_size_row * (vc->vc_bottom - vc->vc_top) / 2);
+		if (fbcon_decor_active(info, vc))
+			fbcon_decor_clear_margins(vc, info, 0);
+	}
+
+	pr_info("fbcondecor: switched decor state to 'on' on console %d\n",
+		vc->vc_num);
+
+	return 0;
+}
+
+/*
+ * The video mode (or the framebuffer) of a decorated console changed: switch
+ * the decorations off and ask the helper for a matching configuration and
+ * picture. Called with the console lock held.
+ */
+void fbcon_decor_modechange(struct vc_data *vc)
+{
+	fbcon_decor_disable(vc, false);
+	fbcon_decor_call_helper("modechange", vc->vc_num);
+}
+
+/* Called with the console lock held. */
+static struct vc_data *fbcon_decor_vc(unsigned int vc_num)
+{
+	if (vc_num >= MAX_NR_CONSOLES || !vc_cons_allocated(vc_num))
+		return NULL;
+
+	return vc_cons[vc_num].d;
+}
+
+static int fbcon_decor_ioctl_dosetstate(unsigned int vc_num, unsigned int state)
+{
+	struct vc_data *vc;
+	int ret;
+
+	console_lock();
+	vc = fbcon_decor_vc(vc_num);
+	if (!vc)
+		ret = -EINVAL;
+	else if (state)
+		ret = fbcon_decor_enable(vc);
+	else
+		ret = fbcon_decor_disable(vc, true);
+	console_unlock();
+
+	return ret;
+}
+
+static int fbcon_decor_ioctl_dogetstate(unsigned int vc_num, unsigned int *state)
+{
+	struct vc_data *vc;
+	int ret = 0;
+
+	console_lock();
+	vc = fbcon_decor_vc(vc_num);
+	if (vc)
+		*state = vc->vc_decor.state;
+	else
+		ret = -EINVAL;
+	console_unlock();
+
+	return ret;
+}
+
+/* @cfg->theme points to user memory. */
+static int fbcon_decor_ioctl_dosetcfg(unsigned int vc_num,
+				      const struct vc_decor *cfg)
+{
+	struct fb_info *info;
+	struct vc_data *vc;
+	char *theme;
+	int ret = 0;
+
+	if (!cfg->twidth || !cfg->theight)
+		return -EINVAL;
+
+	theme = strndup_user((const char __force __user *)cfg->theme,
+			     FBCON_DECOR_THEME_LEN);
+	if (IS_ERR(theme))
+		return PTR_ERR(theme);
+
+	console_lock();
+	vc = fbcon_decor_vc(vc_num);
+	info = vc ? fbcon_info_from_console(vc_num) : NULL;
+	if (!info ||
+	    cfg->tx + cfg->twidth > info->var.xres ||
+	    cfg->ty + cfg->theight > info->var.yres) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+
+	if (vc->vc_decor.state)
+		fbcon_decor_disable(vc, true);
+
+	kfree(vc->vc_decor.theme);
+	vc->vc_decor = *cfg;
+	vc->vc_decor.state = 0;
+	vc->vc_decor.theme = theme;
+	theme = NULL;
+
+	pr_info("fbcondecor: console %d using theme '%s'\n", vc_num,
+		vc->vc_decor.theme);
+
+out_unlock:
+	console_unlock();
+	kfree(theme);
+	return ret;
+}
+
+/* @cfg->theme points to a user buffer of at least FBCON_DECOR_THEME_LEN bytes. */
+static int fbcon_decor_ioctl_dogetcfg(unsigned int vc_num, struct vc_decor *cfg)
+{
+	char __user *utheme = (char __force __user *)cfg->theme;
+	char theme[FBCON_DECOR_THEME_LEN];
+	struct vc_data *vc;
+
+	console_lock();
+	vc = fbcon_decor_vc(vc_num);
+	if (!vc) {
+		console_unlock();
+		return -EINVAL;
+	}
+	*cfg = vc->vc_decor;
+	strscpy(theme, vc->vc_decor.theme ? vc->vc_decor.theme : "",
+		sizeof(theme));
+	console_unlock();
+
+	cfg->theme = (char __force *)utheme;
+	if (copy_to_user(utheme, theme, strlen(theme) + 1))
+		return -EFAULT;
+
+	return 0;
+}
+
+/* @img->data and @img->cmap.{red,green,blue} point to user memory. */
+static int fbcon_decor_ioctl_dosetpic(unsigned int vc_num,
+				      const struct fb_image *img)
+{
+	struct fb_info *info;
+	struct vc_data *vc;
+	u16 *cmap = NULL;
+	u8 *data;
+	size_t len, clen = 0;
+	unsigned int bytespp;
+	int ret;
+
+	switch (img->depth) {
+	case 8:
+	case 16:
+	case 24:
+	case 32:
+		bytespp = img->depth / 8;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (!img->width || !img->height ||
+	    check_mul_overflow((size_t)img->width * bytespp, (size_t)img->height,
+			       &len))
+		return -EINVAL;
+
+	console_lock();
+	vc = fbcon_decor_vc(vc_num);
+	info = vc ? fbcon_info_from_console(vc_num) : NULL;
+	if (!info || vc_num != fg_console) {
+		ret = -EINVAL;
+	} else if (img->width != info->var.xres ||
+		   img->height != info->var.yres) {
+		pr_err("fbcondecor: picture dimensions mismatch: %ux%u vs %ux%u\n",
+		       img->width, img->height, info->var.xres, info->var.yres);
+		ret = -EINVAL;
+	} else if (img->depth != info->var.bits_per_pixel) {
+		pr_err("fbcondecor: picture depth mismatch: %u vs %u\n",
+		       img->depth, info->var.bits_per_pixel);
+		ret = -EINVAL;
+	} else {
+		ret = 0;
+	}
+	console_unlock();
+	if (ret)
+		return ret;
+
+	if (img->depth == 8) {
+		if (!img->cmap.len || img->cmap.len > 256 ||
+		    !img->cmap.red || !img->cmap.green || !img->cmap.blue)
+			return -EINVAL;
+
+		clen = img->cmap.len * sizeof(u16);
+		cmap = kmalloc(3 * clen, GFP_KERNEL);
+		if (!cmap)
+			return -ENOMEM;
+
+		if (copy_from_user(cmap,
+				   (const void __force __user *)img->cmap.red, clen) ||
+		    copy_from_user(cmap + img->cmap.len,
+				   (const void __force __user *)img->cmap.green, clen) ||
+		    copy_from_user(cmap + 2 * img->cmap.len,
+				   (const void __force __user *)img->cmap.blue, clen)) {
+			kfree(cmap);
+			return -EFAULT;
+		}
+	}
+
+	/*
+	 * Allocate an additional byte so that we never go outside of the
+	 * buffer boundaries in the rendering functions in a 24 bpp mode.
+	 */
+	data = vmalloc(len + 1);
+	if (!data) {
+		kfree(cmap);
+		return -ENOMEM;
+	}
+
+	if (copy_from_user(data, (const void __force __user *)img->data, len)) {
+		ret = -EFAULT;
+		goto out_free;
+	}
+
+	console_lock();
+	vc = fbcon_decor_vc(vc_num);
+	info = vc ? fbcon_info_from_console(vc_num) : NULL;
+	if (!info || vc_num != fg_console ||
+	    img->width != info->var.xres || img->height != info->var.yres ||
+	    img->depth != info->var.bits_per_pixel) {
+		console_unlock();
+		ret = -EINVAL;
+		goto out_free;
+	}
+
+	fbcon_decor_release_info(info);
+	info->bgdecor = *img;
+	info->bgdecor.data = data;
+	info->bgdecor_theme = kstrdup(vc->vc_decor.theme, GFP_KERNEL);
+	memset(&info->bgdecor.cmap, 0, sizeof(info->bgdecor.cmap));
+	if (cmap) {
+		info->bgdecor.cmap.start = img->cmap.start;
+		info->bgdecor.cmap.len = img->cmap.len;
+		info->bgdecor.cmap.red = cmap;
+		info->bgdecor.cmap.green = cmap + img->cmap.len;
+		info->bgdecor.cmap.blue = cmap + 2 * img->cmap.len;
+	}
+
+	if (fbcon_decor_active(info, vc)) {
+		redraw_screen(vc, 0);
+		update_region(vc, vc->vc_origin + vc->vc_size_row * vc->vc_top,
+			      vc->vc_size_row * (vc->vc_bottom - vc->vc_top) / 2);
+		fbcon_decor_clear_margins(vc, info, 0);
+	}
+
+	console_unlock();
+
+	return 0;
+
+out_free:
+	vfree(data);
+	kfree(cmap);
+	return ret;
+}
+
+static long fbcon_decor_do_ioctl(unsigned int cmd, unsigned int vc_num,
+				 void __user *data)
+{
+	switch (cmd) {
+	case FBIOCONDECOR_SETPIC: {
+		struct fb_image img;
+
+		if (copy_from_user(&img, data, sizeof(img)))
+			return -EFAULT;
+
+		return fbcon_decor_ioctl_dosetpic(vc_num, &img);
+	}
+	case FBIOCONDECOR_SETCFG: {
+		struct vc_decor cfg;
+
+		if (copy_from_user(&cfg, data, sizeof(cfg)))
+			return -EFAULT;
+
+		return fbcon_decor_ioctl_dosetcfg(vc_num, &cfg);
+	}
+	case FBIOCONDECOR_GETCFG: {
+		struct vc_decor cfg;
+		int ret;
+
+		if (copy_from_user(&cfg, data, sizeof(cfg)))
+			return -EFAULT;
+
+		ret = fbcon_decor_ioctl_dogetcfg(vc_num, &cfg);
+		if (ret)
+			return ret;
+
+		return copy_to_user(data, &cfg, sizeof(cfg)) ? -EFAULT : 0;
+	}
+	case FBIOCONDECOR_SETSTATE: {
+		unsigned int state;
+
+		if (get_user(state, (unsigned int __user *)data))
+			return -EFAULT;
+
+		return fbcon_decor_ioctl_dosetstate(vc_num, state);
+	}
+	case FBIOCONDECOR_GETSTATE: {
+		unsigned int state = 0;
+		int ret;
+
+		ret = fbcon_decor_ioctl_dogetstate(vc_num, &state);
+		if (ret)
+			return ret;
+
+		return put_user(state, (unsigned int __user *)data);
+	}
+	default:
+		return -ENOIOCTLCMD;
+	}
+}
+
+static long fbcon_decor_ioctl(struct file *filp, unsigned int cmd,
+			      unsigned long arg)
+{
+	struct fbcon_decor_iowrapper wrapper;
+
+	if (copy_from_user(&wrapper, (void __user *)arg, sizeof(wrapper)))
+		return -EFAULT;
+
+	return fbcon_decor_do_ioctl(cmd, wrapper.vc,
+				    (void __force __user *)wrapper.data);
+}
+
+#ifdef CONFIG_COMPAT
+
+struct fbcon_decor_iowrapper32 {
+	unsigned short vc;		/* Virtual console */
+	unsigned char origin;		/* Point of origin of the request */
+	compat_uptr_t data;
+};
+
+struct vc_decor32 {
+	__u8 bg_color;
+	__u8 state;
+	__u16 tx, ty;
+	__u16 twidth, theight;
+	compat_uptr_t theme;
+};
+
+struct fb_cmap32 {
+	__u32 start;
+	__u32 len;
+	compat_uptr_t red;
+	compat_uptr_t green;
+	compat_uptr_t blue;
+	compat_uptr_t transp;
+};
+
+struct fb_image32 {
+	__u32 dx;
+	__u32 dy;
+	__u32 width;
+	__u32 height;
+	__u32 fg_color;
+	__u32 bg_color;
+	__u8 depth;
+	compat_uptr_t data;
+	struct fb_cmap32 cmap;
+};
+
+#define FBIOCONDECOR_SETCFG32	_IOWR('F', 0x19, struct fbcon_decor_iowrapper32)
+#define FBIOCONDECOR_GETCFG32	_IOR('F', 0x1A, struct fbcon_decor_iowrapper32)
+#define FBIOCONDECOR_SETSTATE32	_IOWR('F', 0x1B, struct fbcon_decor_iowrapper32)
+#define FBIOCONDECOR_GETSTATE32	_IOR('F', 0x1C, struct fbcon_decor_iowrapper32)
+#define FBIOCONDECOR_SETPIC32	_IOWR('F', 0x1D, struct fbcon_decor_iowrapper32)
+
+static void vc_decor_from_compat(struct vc_decor *to, const struct vc_decor32 *from)
+{
+	to->bg_color = from->bg_color;
+	to->state = from->state;
+	to->tx = from->tx;
+	to->ty = from->ty;
+	to->twidth = from->twidth;
+	to->theight = from->theight;
+	to->theme = (char __force *)compat_ptr(from->theme);
+}
+
+static void vc_decor_to_compat(struct vc_decor32 *to, const struct vc_decor *from)
+{
+	to->bg_color = from->bg_color;
+	to->state = from->state;
+	to->tx = from->tx;
+	to->ty = from->ty;
+	to->twidth = from->twidth;
+	to->theight = from->theight;
+	to->theme = ptr_to_compat((void __force __user *)from->theme);
+}
+
+static long fbcon_decor_compat_ioctl(struct file *filp, unsigned int cmd,
+				     unsigned long arg)
+{
+	struct fbcon_decor_iowrapper32 wrapper;
+	void __user *data;
+
+	if (copy_from_user(&wrapper, compat_ptr(arg), sizeof(wrapper)))
+		return -EFAULT;
+	data = compat_ptr(wrapper.data);
+
+	switch (cmd) {
+	case FBIOCONDECOR_SETPIC32: {
+		struct fb_image32 img32;
+		struct fb_image img;
+
+		if (copy_from_user(&img32, data, sizeof(img32)))
+			return -EFAULT;
+
+		memset(&img, 0, sizeof(img));
+		img.dx = img32.dx;
+		img.dy = img32.dy;
+		img.width = img32.width;
+		img.height = img32.height;
+		img.fg_color = img32.fg_color;
+		img.bg_color = img32.bg_color;
+		img.depth = img32.depth;
+		img.data = (const char __force *)compat_ptr(img32.data);
+		img.cmap.start = img32.cmap.start;
+		img.cmap.len = img32.cmap.len;
+		img.cmap.red = (__u16 __force *)compat_ptr(img32.cmap.red);
+		img.cmap.green = (__u16 __force *)compat_ptr(img32.cmap.green);
+		img.cmap.blue = (__u16 __force *)compat_ptr(img32.cmap.blue);
+		img.cmap.transp = (__u16 __force *)compat_ptr(img32.cmap.transp);
+
+		return fbcon_decor_ioctl_dosetpic(wrapper.vc, &img);
+	}
+	case FBIOCONDECOR_SETCFG32: {
+		struct vc_decor32 cfg32;
+		struct vc_decor cfg;
+
+		if (copy_from_user(&cfg32, data, sizeof(cfg32)))
+			return -EFAULT;
+
+		vc_decor_from_compat(&cfg, &cfg32);
+
+		return fbcon_decor_ioctl_dosetcfg(wrapper.vc, &cfg);
+	}
+	case FBIOCONDECOR_GETCFG32: {
+		struct vc_decor32 cfg32;
+		struct vc_decor cfg;
+		int ret;
+
+		if (copy_from_user(&cfg32, data, sizeof(cfg32)))
+			return -EFAULT;
+
+		vc_decor_from_compat(&cfg, &cfg32);
+		ret = fbcon_decor_ioctl_dogetcfg(wrapper.vc, &cfg);
+		if (ret)
+			return ret;
+		vc_decor_to_compat(&cfg32, &cfg);
+
+		return copy_to_user(data, &cfg32, sizeof(cfg32)) ? -EFAULT : 0;
+	}
+	case FBIOCONDECOR_SETSTATE32: {
+		compat_uint_t state;
+
+		if (get_user(state, (compat_uint_t __user *)data))
+			return -EFAULT;
+
+		return fbcon_decor_ioctl_dosetstate(wrapper.vc, state);
+	}
+	case FBIOCONDECOR_GETSTATE32: {
+		unsigned int state = 0;
+		int ret;
+
+		ret = fbcon_decor_ioctl_dogetstate(wrapper.vc, &state);
+		if (ret)
+			return ret;
+
+		return put_user((compat_uint_t)state, (compat_uint_t __user *)data);
+	}
+	default:
+		return -ENOIOCTLCMD;
+	}
+}
+
+#endif /* CONFIG_COMPAT */
+
+static const struct file_operations fbcon_decor_fops = {
+	.owner		= THIS_MODULE,
+	.unlocked_ioctl	= fbcon_decor_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl	= fbcon_decor_compat_ioctl,
+#endif
+};
+
+static struct miscdevice fbcon_decor_dev = {
+	.minor	= MISC_DYNAMIC_MINOR,
+	.name	= "fbcondecor",
+	.fops	= &fbcon_decor_fops,
+};
+
+/* Frees the background picture of a framebuffer. */
+void fbcon_decor_release_info(struct fb_info *info)
+{
+	vfree(info->bgdecor.data);
+	kfree(info->bgdecor.cmap.red);
+	kfree(info->bgdecor_theme);
+	memset(&info->bgdecor, 0, sizeof(info->bgdecor));
+	info->bgdecor_theme = NULL;
+}
+
+/* Forgets the decoration configuration of a virtual console. */
+void fbcon_decor_vc_reset(struct vc_data *vc)
+{
+	kfree(vc->vc_decor.theme);
+	memset(&vc->vc_decor, 0, sizeof(vc->vc_decor));
+}
+
+/*
+ * Called with the console lock held whenever fbcon takes over the console.
+ * The control device and the sysctl are registered once; the helper is
+ * asked to initialize the decorations on every takeover, as a framebuffer
+ * driver replacing another one (e.g. amdgpu after simpledrm) starts with
+ * no picture and consoles with no configuration.
+ */
+void fbcon_decor_init(void)
+{
+	if (!fbcon_decor_registered) {
+		int err = misc_register(&fbcon_decor_dev);
+
+		if (err) {
+			pr_err("fbcondecor: failed to register device (%d)\n", err);
+			return;
+		}
+
+		if (!register_sysctl("kernel", fbcon_decor_sysctl_table))
+			pr_warn("fbcondecor: failed to register sysctl\n");
+
+		fbcon_decor_registered = true;
+	}
+
+	fbcon_decor_call_helper("init", 0);
+}
