new file mode 100644
index 000000000000..967a081cbe1c
--- /dev/null
+++ b/drivers/video/fbdev/core/fbcondecor.h
@@ -0,0 +1,143 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ *  linux/drivers/video/fbdev/core/fbcondecor.h -- Framebuffer Console Decoration headers
+ *
+ *  Copyright (C) 2004 Michal Januszewski <michalj+fbcondecor@gmail.com>
+ */
+
+#ifndef _VIDEO_FBCONDECOR_H
+#define _VIDEO_FBCONDECOR_H
+
+#include <linux/fb.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/vt_kern.h>
+
+#include "fbcon.h"
+
+struct fb_cursor;
+struct fb_info;
+struct vc_data;
+
+#ifdef CONFIG_FB_CON_DECOR
+
+/* fbcondecor.c; all functions must be called with the console lock held */
+void fbcon_decor_init(void);
+void fbcon_decor_release_info(struct fb_info *info);
+void fbcon_decor_vc_reset(struct vc_data *vc);
+int fbcon_decor_call_helper(const char *cmd, unsigned short vc_num);
+int fbcon_decor_disable(struct vc_data *vc, bool redraw);
+void fbcon_decor_modechange(struct vc_data *vc);
+
+/* cfbcondecor.c; only to be called when fbcon_decor_active() is true */
+void fbcon_decor_putcs(struct vc_data *vc, struct fb_info *info,
+		       const unsigned short *s, int count, int yy, int xx,
+		       int fg_color, int bg_color);
+void fbcon_decor_cursor(struct fb_info *info, struct fb_cursor *cursor);
+void fbcon_decor_clear(struct vc_data *vc, struct fb_info *info, int sy, int sx,
+		       int height, int width, int bg_color);
+void fbcon_decor_clear_margins(struct vc_data *vc, struct fb_info *info,
+			       int bottom_only);
+void fbcon_decor_blank(struct vc_data *vc, struct fb_info *info, int blank);
+void fbcon_decor_set_palette(struct vc_data *vc, struct fb_info *info);
+
+/* The console has decorations configured and switched on. */
+static inline bool fbcon_decor_active_vc(const struct vc_data *vc)
+{
+	return vc->vc_decor.state && vc->vc_decor.theme;
+}
+
+/* The framebuffer has a background picture matching the current video mode. */
+static inline bool fbcon_decor_picture_fits(const struct fb_info *info)
+{
+	return info->bgdecor.data &&
+	       info->bgdecor.width == info->var.xres &&
+	       info->bgdecor.height == info->var.yres &&
+	       info->bgdecor.depth == info->var.bits_per_pixel;
+}
+
+/* ... and it was loaded for the theme of @vc. */
+static inline bool fbcon_decor_picture_ok(const struct fb_info *info,
+					  const struct vc_data *vc)
+{
+	return fbcon_decor_picture_fits(info) && info->bgdecor_theme &&
+	       vc->vc_decor.theme &&
+	       !strcmp(info->bgdecor_theme, vc->vc_decor.theme);
+}
+
+/*
+ * The console has decorations switched on and the framebuffer a picture
+ * matching the video mode, so the decorations can actually be drawn.
+ * Rotated consoles are not supported.
+ */
+static inline bool fbcon_decor_active(const struct fb_info *info,
+				      const struct vc_data *vc)
+{
+	const struct fbcon_par *par = info->fbcon_par;
+
+	return fbcon_decor_active_vc(vc) && fbcon_decor_picture_fits(info) &&
+	       par && par->rotate == FB_ROTATE_UR;
+}
+
+static inline bool fbcon_decor_vc_state(const struct vc_data *vc)
+{
+	return vc->vc_decor.state;
+}
+
+#else /* CONFIG_FB_CON_DECOR */
+
+static inline void fbcon_decor_init(void) {}
+static inline void fbcon_decor_release_info(struct fb_info *info) {}
+static inline void fbcon_decor_vc_reset(struct vc_data *vc) {}
+static inline int fbcon_decor_call_helper(const char *cmd, unsigned short vc_num)
+{
+	return 0;
+}
+static inline int fbcon_decor_disable(struct vc_data *vc, bool redraw)
+{
+	return 0;
+}
+static inline void fbcon_decor_modechange(struct vc_data *vc) {}
+
+static inline void fbcon_decor_putcs(struct vc_data *vc, struct fb_info *info,
+				     const unsigned short *s, int count,
+				     int yy, int xx, int fg_color, int bg_color) {}
+static inline void fbcon_decor_cursor(struct fb_info *info,
+				      struct fb_cursor *cursor) {}
+static inline void fbcon_decor_clear(struct vc_data *vc, struct fb_info *info,
+				     int sy, int sx, int height, int width,
+				     int bg_color) {}
+static inline void fbcon_decor_clear_margins(struct vc_data *vc,
+					     struct fb_info *info,
+					     int bottom_only) {}
+static inline void fbcon_decor_blank(struct vc_data *vc, struct fb_info *info,
+				     int blank) {}
+static inline void fbcon_decor_set_palette(struct vc_data *vc,
+					   struct fb_info *info) {}
+
+static inline bool fbcon_decor_active_vc(const struct vc_data *vc)
+{
+	return false;
+}
+static inline bool fbcon_decor_picture_fits(const struct fb_info *info)
+{
+	return false;
+}
+static inline bool fbcon_decor_picture_ok(const struct fb_info *info,
+					  const struct vc_data *vc)
+{
+	return false;
+}
+static inline bool fbcon_decor_active(const struct fb_info *info,
+				      const struct vc_data *vc)
+{
+	return false;
+}
+static inline bool fbcon_decor_vc_state(const struct vc_data *vc)
+{
+	return false;
+}
+
+#endif /* CONFIG_FB_CON_DECOR */
+
+#endif /* _VIDEO_FBCONDECOR_H */
