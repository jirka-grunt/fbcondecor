diff --git a/include/uapi/linux/console_decor.h b/include/uapi/linux/console_decor.h
new file mode 100644
index 000000000000..cb113bba127d
--- /dev/null
+++ b/include/uapi/linux/console_decor.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_CONSOLE_DECOR_H
+#define _UAPI_LINUX_CONSOLE_DECOR_H
+
+#include <linux/types.h>
+
+/*
+ * Configuration of the framebuffer console decorations for one virtual
+ * console (drivers/video/fbdev/core/fbcondecor.c)
+ */
+struct vc_decor {
+	__u8 bg_color;		/* The color that is to be treated as transparent */
+	__u8 state;		/* Current decor state: 0 = off, 1 = on */
+	__u16 tx, ty;		/* Top left corner coordinates of the text field */
+	__u16 twidth, theight;	/* Width and height of the text field */
+	char *theme;		/* Theme name, at most FBCON_DECOR_THEME_LEN bytes */
+};
+
+#endif /* _UAPI_LINUX_CONSOLE_DECOR_H */
